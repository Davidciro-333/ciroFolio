---
// src/components/ContactForm.astro
//
// Formulario corto de primer contacto. Deliberadamente asíncrono: no hay
// botón de "agendar llamada". El primer intercambio ocurre por escrito, que
// es donde se puede pensar la respuesta y llegar preparado a la llamada.
//
// Los campos de plazo y presupuesto filtran: quien no los quiere responder
// tampoco iba a cerrar.

import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { contactForm, isFormEnabled } from '../data/contact';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Etiqueta encima, 16 px (evita el zoom de iOS al enfocar), radio 8, foco azul.
const fieldClass = 'field';
---

<form
  id="contact-form"
  class="flex flex-col gap-5"
  data-endpoint={contactForm.endpoint}
  data-access-key={contactForm.accessKey}
  data-subject={contactForm.subject}
  data-from-name={contactForm.fromName}
  data-mailto={profile.email}
  data-enabled={String(isFormEnabled)}
  novalidate={false}
>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="flex flex-col gap-2">
      <label for="cf-name" class="label">{t(ui.form.name)} <span class="req">({t(ui.form.required)})</span></label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" class={fieldClass} />
    </div>

    <div class="flex flex-col gap-2">
      <label for="cf-company" class="label">{t(ui.form.company)}</label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" class={fieldClass} />
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <label for="cf-email" class="label">{t(ui.form.email)} <span class="req">({t(ui.form.required)})</span></label>
    <input id="cf-email" name="email" type="email" required autocomplete="email" class={fieldClass} />
  </div>

  <div class="flex flex-col gap-2">
    <label for="cf-project" class="label">{t(ui.form.project)} <span class="req">({t(ui.form.required)})</span></label>
    <textarea id="cf-project" name="project" required rows="4" class={fieldClass}></textarea>
    <p class="hint">{t(ui.form.projectHint)}</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="flex flex-col gap-2">
      <label for="cf-timeline" class="label">{t(ui.form.timeline)}</label>
      <select id="cf-timeline" name="timeline" class={fieldClass}>
        <option value="">{t(ui.form.select)}</option>
        {t(ui.form.timelineOptions).map((option) => (
          <option value={option}>{option}</option>
        ))}
      </select>
    </div>

    <div class="flex flex-col gap-2">
      <label for="cf-budget" class="label">{t(ui.form.budget)}</label>
      <select id="cf-budget" name="budget" class={fieldClass}>
        <option value="">{t(ui.form.select)}</option>
        {t(ui.form.budgetOptions).map((option) => (
          <option value={option}>{option}</option>
        ))}
      </select>
    </div>
  </div>

  <!-- Trampa antispam: invisible para personas, irresistible para bots -->
  <input
    type="text"
    name="botcheck"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    style="position:absolute;left:-9999px;opacity:0;height:0;width:0;"
  />

  <div class="flex items-center gap-4 flex-wrap">
    <button type="submit" class="pill" data-sending={t(ui.form.sending)}>
      {t(ui.form.submit)}
    </button>

    <p
      id="cf-status"
      role="status"
      aria-live="polite"
      class="status"
      data-success={t(ui.form.success)}
      data-error={t(ui.form.error)}
    ></p>
  </div>
</form>

<style>
  .label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .req { font-weight: 400; color: var(--ink-3); }
  .hint,
  .status {
    font-size: 14px;
    color: var(--ink-3);
  }
  .field {
    width: 100%;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--ink-3);
    border-radius: 8px;
    padding: 11px 14px;
    transition: border-color 0.2s ease, background-color 0.4s ease;
  }
  .field:hover { border-color: var(--ink-2); }
  .field:focus {
    outline: 2px solid var(--blue);
    outline-offset: 1px;
    border-color: var(--blue);
  }
  textarea.field { resize: vertical; min-height: 112px; }

  /* El desplegable nativo de un <select> lo pinta el sistema operativo, no la
     página. color-scheme ya lo fija el :root según el tema (claro u oscuro),
     así que el popup sigue al tema; los colores explícitos en option cubren a
     los navegadores que no lo aplican al desplegable (el bug "blanco sobre
     blanco" de la v1). */
  select.field option {
    background-color: var(--bg);
    color: var(--ink);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');
  if (form && status) {
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const buttonIdle = button.innerHTML;
    const labelSending = button.dataset.sending ?? 'Sending…';

    // Asunto con lo justo para priorizar desde la bandeja sin abrir el correo.
    // El presupuesto y el plazo salen de <select>, así que son valores cerrados;
    // el nombre es texto libre del visitante y por eso se recorta.
    const buildSubject = (data: FormData) => {
      const base = form.dataset.subject ?? 'New inquiry';
      const name = String(data.get('name') ?? '').trim().slice(0, 40);
      const rest = [data.get('budget'), data.get('timeline')]
        .map((value) => String(value ?? '').trim())
        .filter(Boolean);

      return [name ? `${base} — ${name}` : base, ...rest].join(' · ');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);

      // Trampa antispam rellenada → un bot. Se finge éxito y no se envía nada.
      if (data.get('botcheck')) {
        status.textContent = status.dataset.success ?? '';
        form.reset();
        return;
      }

      // Sin endpoint configurado: se abre el cliente de correo con todo
      // escrito, para no perder el contacto por falta de configuración.
      if (form.dataset.enabled !== 'true') {
        const body = [...data.entries()]
          .filter(([key, value]) => key !== 'botcheck' && value)
          .map(([key, value]) => `${key}: ${value}`)
          .join('\n');
        const subject = encodeURIComponent(buildSubject(data));
        window.location.href =
          `mailto:${form.dataset.mailto}?subject=${subject}&body=${encodeURIComponent(body)}`;
        return;
      }

      button.disabled = true;
      button.textContent = labelSending;
      status.textContent = '';

      try {
        data.append('access_key', form.dataset.accessKey ?? '');
        data.append('subject', buildSubject(data));
        data.append('from_name', form.dataset.fromName ?? '');

        const response = await fetch(form.dataset.endpoint ?? '', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });

        // Web3Forms responde 200 con {"success": false} cuando rechaza el
        // envío —key inválida, spam, cuota agotada—, así que mirar solo
        // response.ok daría por enviado un mensaje que nunca salió y el
        // contacto se perdería en silencio. La confirmación es el cuerpo.
        //
        // Si el cuerpo no se puede leer, se cuenta como fallo: sin
        // confirmación explícita no se anuncia éxito. Decir "algo falló"
        // cuando sí llegó cuesta un correo duplicado; decir "recibido"
        // cuando no llegó cuesta el contacto entero.
        const result: { success?: boolean; message?: string } | null =
          await response.json().catch(() => null);

        if (!response.ok || result?.success !== true) {
          throw new Error(result?.message ?? `HTTP ${response.status}`);
        }

        status.textContent = status.dataset.success ?? '';
        form.reset();
      } catch (error) {
        console.error('[contact-form]', error);
        status.textContent = status.dataset.error ?? '';
      } finally {
        button.disabled = false;
        // innerHTML y no textContent: el botón lleva la flecha ↗ en un span,
        // y asignar texto plano la borraba para siempre tras el primer envío.
        button.innerHTML = buttonIdle;
      }
    });
  }
</script>
