---
// src/components/Contratacion.astro
// Modalidades de contratación: responde a "¿cómo te contrato?", que es lo que
// una agencia necesita saber, no a "¿qué sabes hacer?". Cuatro columnas
// separadas por hairlines, sin tarjetas (DESIGN.md §5).

import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { engagements } from '../data/engagement';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="engagements" class="section wrap">
  <h2 class="sec-title reveal">{t(ui.services.title)}</h2>

  <div class="modes">
    {engagements.map((item) => (
      <article class="mode reveal">
        <h3>{t(item.title)}</h3>
        <p>{t(item.description)}</p>
        <ul>
          {t(item.tags).map((tag) => <li>{tag}</li>)}
        </ul>
      </article>
    ))}
  </div>

  <p class="note reveal">{t(ui.services.note)}</p>
</section>

<style>
  .sec-title { text-align: center; }
  .modes {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }
  .mode { padding: 32px 24px 8px 0; }
  .mode + .mode {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }
  h3 {
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  p {
    margin-top: 10px;
    font-size: 15px;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  ul {
    list-style: none;
    margin-top: 18px;
    font-size: 14px;
    color: var(--ink-3);
  }
  li {
    padding: 6px 0;
    border-top: 1px solid var(--line);
  }
  .note {
    margin-top: 36px;
    text-align: center;
    color: var(--ink-3);
  }

  @media (max-width: 1023px) and (min-width: 860px) {
    .modes { grid-template-columns: repeat(2, 1fr); }
    .mode:nth-child(3) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 859px) {
    .modes { grid-template-columns: 1fr; margin-top: 40px; }
    .mode,
    .mode + .mode {
      padding: 24px 0;
      border-left: 0;
    }
    .mode + .mode { border-top: 1px solid var(--line); }
  }
</style>
