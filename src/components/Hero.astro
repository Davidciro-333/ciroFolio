---
// src/components/Hero.astro
// El único bloque centrado del sitio: aquí el mensaje es el diseño.
// Máximo cuatro elementos de texto (DESIGN.md §5): kicker, titular, lede, CTAs.
// Debajo, el retrato: la persona detrás de los sistemas.

import { Image } from 'astro:assets';
import { ui } from '../i18n/ui';
import { useTranslations, localePath } from '../i18n/utils';
import profilePhoto from '../assets/photoProfile.png';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, '/');
---

<section id="top" class="hero wrap">
  <p class="kicker reveal">{t(ui.hero.kicker)}</p>
  <h1 class="display reveal">{t(ui.hero.title)}</h1>
  <p class="lede reveal">
    {t(ui.hero.lede)} <mark class="hl">{t(ui.hero.ledeMark)}</mark>
  </p>
  <div class="ctas reveal">
    <a href={`${home}#systems`} class="pill">{t(ui.hero.ctaWork)}</a>
    <a href={`${home}#contact`} class="text-link more">{t(ui.hero.ctaContact)}</a>
  </div>
</section>

<div class="portrait wrap">
  <figure>
    <div class="frame">
      <!-- El original es un PNG de 4096 px y 1 MB: Astro lo sirve a la medida -->
      <Image
        src={profilePhoto}
        alt={t(ui.hero.photoAlt)}
        widths={[480, 720, 960, 1440, 1920]}
        sizes="(max-width: 1008px) calc(100vw - 32px), 960px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <figcaption>{t(ui.hero.caption)}</figcaption>
  </figure>
</div>

<style>
  .hero {
    text-align: center;
    padding-top: 88px;
    padding-bottom: 56px;
  }
  .display {
    margin: 12px auto 0;
    max-width: 14ch;
    text-wrap: balance;
  }
  .lede {
    margin: 22px auto 0;
    max-width: 40ch;
  }
  .ctas {
    margin-top: 32px;
    display: flex;
    gap: 28px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    font-size: 17px;
  }

  .portrait { max-width: calc(960px + 2 * var(--gutter)); }
  .frame {
    border-radius: 32px;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: var(--parch);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    filter: brightness(var(--photo-dim));
    transition: filter 0.4s ease;
  }
  figcaption {
    margin-top: 16px;
    text-align: center;
    font-size: 14px;
    color: var(--ink-3);
  }

  /* La foto crece con el scroll: CSS puro, sin JavaScript. Donde no hay
     soporte se queda quieta, que también está bien. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .frame {
        animation: portrait-grow linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }
  @keyframes portrait-grow {
    from { transform: scale(0.88); border-radius: 48px; }
    to   { transform: scale(1);    border-radius: 32px; }
  }

  @media (max-width: 859px) {
    .hero { padding-top: 56px; padding-bottom: 40px; }
    .frame { aspect-ratio: 4 / 5; border-radius: 24px; }
  }
</style>
