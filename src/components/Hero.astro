---
// src/components/Hero.astro

import { Image } from 'astro:assets';
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import profilePhoto from '../assets/photoProfile.png';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const [firstName, lastName] = profile.name.toUpperCase().split(' ');
---

<section
  id="inicio"
  class="card-dark relative overflow-hidden
         px-8 md:px-12 lg:px-16
         pt-12 pb-14 md:pt-14 md:pb-16
         min-h-[88vh] flex flex-col"
>

  <!-- Orbs de luz ambiental -->
  <div
    class="orb orb-neon animate-neon-pulse"
    style="width:640px;height:640px;top:-180px;left:-160px;"
    aria-hidden="true"
  ></div>
  <div
    class="orb orb-warm"
    style="width:500px;height:500px;bottom:-100px;right:60px;"
    aria-hidden="true"
  ></div>

  <!-- Grid principal — empuja el contenido hacia abajo -->
  <div class="relative z-10 flex-1 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-10 md:gap-16 lg:gap-24 items-end">

    <!-- ── Columna izquierda: año + nombre + foto ─────────── -->
    <div>

      <!-- Año decorativo, alineado a la derecha dentro de la columna -->
      <p class="type-year text-neon text-right animate-fade-up delay-100">(20/26)</p>

      <!-- Nombre masivo -->
      <div class="mt-1 leading-none">
        <p class="type-hero animate-fade-up delay-200">{firstName}</p>

        <!-- Apellido + foto circular inline -->
        <div class="flex items-center gap-4 md:gap-5 animate-fade-up delay-300">
          <span class="type-hero">{lastName}</span>

          <!-- Foto de perfil — optimizada por Astro (el original es un PNG de 1 MB) -->
          <div
            class="w-[72px] h-[72px] md:w-[88px] md:h-[88px]
                   rounded-full border border-white/10 overflow-hidden
                   flex-shrink-0 flex items-center justify-center
                   bg-[var(--color-surface-2)]"
          >
            <Image
              src={profilePhoto}
              alt={profile.name}
              width={176}
              height={176}
              densities={[1, 2]}
              loading="eager"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- ── Columna derecha: bio + separador + botones ──────── -->
    <div class="max-w-[320px] flex flex-col gap-5 pb-1 animate-fade-up delay-400">

      <div>
        <p class="type-label mb-3">{t(ui.hero.role)}</p>
        <p class="type-body">{t(profile.heroBio)}</p>
      </div>

      <div class="sep-dark"></div>

      <div class="flex items-center gap-3 flex-wrap">
        <a href="#proyectos" class="btn-primary">
          {t(ui.hero.ctaWork)} <span aria-hidden="true">↗</span>
        </a>
        <a href="#contacto" class="btn-ghost">
          {t(ui.hero.ctaContact)}
        </a>
      </div>

    </div>

  </div>
</section>
