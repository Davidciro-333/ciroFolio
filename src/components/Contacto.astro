---
// src/components/Contacto.astro
// Banda de pergamino a todo el ancho: el cierre de la página. El formulario es
// la conversión del sitio; el correo y las redes, la vía secundaria.

import ContactForm from './ContactForm.astro';
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="contact">
  <div class="wrap grid">
    <div class="intro">
      <h2 class="sec-title reveal">{t(ui.contact.title)}</h2>
      <p class="body reveal">{t(ui.contact.body)}</p>
      <!-- Se declara CÓMO se trabaja (async-first, UTC-5), nunca un nivel de
           idioma: es cierto, es la forma real de trabajar, y muchas agencias
           remotas lo leen como cultura y no como limitación. -->
      <p class="async reveal">{t(ui.contact.async)}</p>

      <div class="direct reveal">
        <p class="label">{t(ui.contact.emailLabel)}</p>
        <a href={`mailto:${profile.email}`} class="text-link email">
          {profile.email}
        </a>
      </div>
    </div>

    <div class="form-card reveal">
      <ContactForm lang={lang} />
    </div>
  </div>
</section>

<!-- Fuera de la sección: así es el pie de la página (landmark contentinfo) -->
<footer class="site-foot-band">
  <div class="wrap site-foot">
    <nav aria-label={t(ui.contact.social)}>
      {profile.social.map((r) => (
        <a href={r.href} target="_blank" rel="noopener noreferrer">
          {r.label}
          {/* Misma señal de "sale del sitio" en todos los enlaces externos. */}
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
    <p>© {new Date().getFullYear()} {profile.name}</p>
  </div>
</footer>

<style>
  .contact {
    margin-top: var(--section);
    background: var(--parch);
    transition: background-color 0.4s ease;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: start;
    padding-top: 112px;
    padding-bottom: 96px;
  }
  .sec-title { max-width: 12ch; }
  .body {
    margin-top: 18px;
    max-width: 40ch;
    font-size: 19px;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .async {
    margin-top: 12px;
    font-size: 15px;
    color: var(--ink-3);
  }
  .direct { margin-top: 40px; }
  .label {
    font-size: 14px;
    color: var(--ink-3);
    margin-bottom: 4px;
  }
  .email {
    font-size: 19px;
    font-weight: 600;
    word-break: break-all;
  }
  .form-card {
    background: var(--bg);
    border-radius: 28px;
    padding: 32px;
    transition: background-color 0.4s ease;
  }
  .site-foot-band {
    background: var(--parch);
    transition: background-color 0.4s ease;
  }
  .site-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 22px;
    padding-bottom: 36px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink-3);
  }
  .site-foot nav { display: flex; gap: 22px; flex-wrap: wrap; }
  .site-foot a { display: inline-flex; gap: 5px; color: var(--ink-2); }
  .site-foot a:hover { color: var(--ink); }

  @media (max-width: 859px) {
    .grid { grid-template-columns: 1fr; gap: 40px; padding-top: 80px; padding-bottom: 64px; }
    .form-card { padding: 24px 20px; }
  }
</style>
