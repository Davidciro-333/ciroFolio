---
// src/components/Contacto.astro

import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="contacto"
  class="card-dark relative overflow-hidden
         px-8 md:px-12 lg:px-16
         pt-12 pb-10 md:pt-16 md:pb-12"
>

  <!-- Orbs ambientales -->
  <div
    class="orb orb-neon animate-neon-pulse"
    style="width:600px;height:600px;bottom:-200px;left:-120px;opacity:0.7;"
    aria-hidden="true"
  ></div>
  <div
    class="orb orb-warm"
    style="width:400px;height:400px;top:-100px;right:-60px;"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 flex flex-col gap-10 md:gap-12">

    <!-- Bloque principal -->
    <div class="flex flex-col gap-6 max-w-4xl">
      <p class="type-label">{t(ui.contact.eyebrow)}</p>

      <h2 class="type-cta leading-none">
        {t(ui.contact.titleLine1)}<br />
        <span class="text-neon">{t(ui.contact.titleHighlight)}</span><br />
        {t(ui.contact.titleLine3)}
      </h2>

      <!-- Disponibilidad -->
      <div class="inline-flex items-center gap-2 w-fit">
        <span class="w-2 h-2 rounded-full bg-[var(--color-neon)] animate-neon-pulse inline-block"></span>
        <span class="type-label" style="color: var(--color-text-muted);">{t(ui.contact.available)}</span>
      </div>
    </div>

    <!-- Email grande -->
    <div>
      <p class="type-label mb-3">{t(ui.contact.emailLabel)}</p>
      <a
        href={`mailto:${profile.email}`}
        class="group inline-flex items-end gap-4 leading-none"
        aria-label={t(ui.contact.emailAria)}
      >
        <span
          class="font-extrabold uppercase tracking-tight
                 text-[clamp(28px,5vw,56px)] leading-none
                 text-[var(--color-text-secondary)]
                 group-hover:text-white transition-colors duration-300"
          style="font-family: var(--font-display);"
        >
          {profile.email}
        </span>
        <span
          class="w-10 h-10 rounded-full border border-white/[0.12] flex items-center justify-center
                 text-[var(--color-text-muted)] text-base mb-1
                 group-hover:border-[var(--color-neon)] group-hover:text-[var(--color-neon)] group-hover:bg-[var(--color-neon)]/10
                 transition-all duration-300 shrink-0"
          aria-hidden="true"
        >↗</span>
      </a>
    </div>

    <div class="sep-dark"></div>

    <!-- Footer: redes + copyright -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">

      <!-- Redes -->
      <nav class="flex items-center gap-6 flex-wrap" aria-label={t(ui.contact.social)}>
        {profile.social.map(r => (
          <a
            href={r.href}
            target="_blank"
            rel="noopener noreferrer"
            class="type-ui hover:text-white transition-colors duration-250"
          >
            {r.label}
          </a>
        ))}
      </nav>

      <!-- Copyright -->
      <p class="type-label" style="color: var(--color-text-faint);">
        © {new Date().getFullYear()} {profile.name}
      </p>

    </div>

  </div>
</section>
