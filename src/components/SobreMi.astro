---
// src/components/SobreMi.astro
// Una frase grande que se lee de lejos, con el segundo y último subrayador de
// la página. Debajo, tres columnas cortas y las cifras (DESIGN.md §5).

import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section wrap">
  <!-- La frase ES el título de la sección: no es una cita, así que va como h2 -->
  <h2 class="statement reveal">
    {t(ui.about.statementStart)} <mark class="hl">{t(ui.about.statementMark)}</mark> {t(ui.about.statementEnd)}
  </h2>

  <div class="cols">
    {profile.aboutColumns.map((col) => (
      <div class="reveal">
        <h3>{t(col.title)}</h3>
        <p>{t(col.body)}</p>
      </div>
    ))}
  </div>

  <dl class="stats">
    {profile.stats.map((s) => (
      <div class="reveal">
        <dt>{t(s.label)}</dt>
        <dd>{s.value}</dd>
      </div>
    ))}
  </dl>

  <p class="stack reveal"><span>{t(ui.about.stack)}:</span> {profile.stack.join(', ')}</p>
</section>

<style>
  .statement {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(30px, 3.8vw, 46px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .cols {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  h3 {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .cols p {
    font-size: 16px;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .stats {
    margin-top: 72px;
    display: flex;
    justify-content: center;
    gap: 88px;
    flex-wrap: wrap;
    text-align: center;
  }
  /* El número va arriba aunque en el HTML el término vaya primero:
     así un lector de pantalla oye "Building since: 2020", no "2020: Building since". */
  .stats div { display: flex; flex-direction: column-reverse; }
  dd {
    font-size: 56px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  dt {
    font-size: 14px;
    color: var(--ink-3);
  }
  .stack {
    margin: 48px auto 0;
    max-width: 70ch;
    text-align: center;
    font-size: 14px;
    color: var(--ink-3);
  }
  .stack span { color: var(--ink-2); font-weight: 600; }

  @media (max-width: 859px) {
    .cols { grid-template-columns: 1fr; gap: 28px; margin-top: 48px; }
    .stats { gap: 40px; margin-top: 56px; }
    dd { font-size: 44px; }
  }
</style>
