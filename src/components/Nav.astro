---
// src/components/Nav.astro
// Barra de navegación — sticky con blur backdrop

import { ui } from '../i18n/ui';
import { useTranslations, getAlternates } from '../i18n/utils';
import { LOCALES, LOCALE_LABELS, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { label: t(ui.nav.services),   href: '#servicios' },
  { label: t(ui.nav.about),      href: '#sobre-mi' },
  { label: t(ui.nav.work),       href: '#proyectos' },
  { label: t(ui.nav.experience), href: '#experiencia' },
];

// Conmutador de idioma: enlaza a esta misma página en el otro idioma.
// Sin redirección automática — el visitante elige y los enlaces compartidos
// no cambian de idioma por su cuenta.
const alternates = getAlternates(Astro.url.pathname);
const otherLangs = LOCALES.filter((locale) => locale !== lang);
---

<header
  id="nav"
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-10 h-[60px]
         border-b border-white/[0.05] transition-all duration-400"
  style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
         background: rgba(10,10,12,0.75);"
>
  <!-- Logo / Menú -->
  <button
    id="nav-menu-btn"
    class="btn-nav-circle"
    aria-label={t(ui.nav.openMenu)}
    aria-expanded="false"
  >
    <span aria-hidden="true" class="leading-none select-none">+</span>
  </button>

  <!-- Links de navegación -->
  <nav class="hidden md:flex items-center gap-8" aria-label={t(ui.nav.mainNav)}>
    {links.map(link => (
      <a
        href={link.href}
        class="type-ui text-text-faint hover:text-text-primary transition-colors duration-250"
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Conmutador de idioma + CTA -->
  <div class="flex items-center gap-3">
    {otherLangs.map((locale) => (
      <a
        href={alternates[locale]}
        hreflang={locale}
        class="type-ui text-text-faint hover:text-text-primary transition-colors duration-250
               border border-white/[0.12] rounded-[99px] px-3 py-1"
        aria-label={t(ui.nav.switchLang)}
      >
        {LOCALE_LABELS[locale]}
      </a>
    ))}

    <a href="#contacto" class="btn-primary md:hidden text-xs px-4 py-2">
      {t(ui.nav.contact)}
    </a>
  </div>
</header>

<!-- Spacer para que el contenido no quede bajo el nav fijo -->
<div class="h-[60px]" aria-hidden="true"></div>

<script>
  // Comportamiento suave del nav al hacer scroll
  const nav = document.getElementById('nav');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      nav?.classList.add('shadow-card-dark');
    } else {
      nav?.classList.remove('shadow-card-dark');
    }
  }, { passive: true });
</script>
