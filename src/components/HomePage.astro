---
// src/components/HomePage.astro
// La home completa. Las páginas por idioma son wrappers de este componente,
// así la estructura no puede divergir entre inglés y español.

import Layout       from '../layouts/Layout.astro';
import Nav          from './Nav.astro';
import Hero         from './Hero.astro';
import Contratacion from './Contratacion.astro';
import SobreMi      from './SobreMi.astro';
import Proyectos   from './Proyectos.astro';
import Experiencia from './Experiencia.astro';
import Contacto    from './Contacto.astro';
import type { Lang } from '../i18n/config';
import { ogRoute, ogImagePath } from '../lib/og-routes';
import { ogCard } from '../data/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout
  lang={lang}
  ogImage={ogImagePath(ogRoute.home(lang))}
  ogImageHeading={ogCard.homeTitle[lang]}
>
  <Nav lang={lang} />

  <!-- Primero la prueba, después la oferta (DESIGN.md §5): los sistemas van
       antes que las modalidades. -->
  <main>
    <Hero         lang={lang} />
    <Proyectos    lang={lang} />
    <Contratacion lang={lang} />
    <SobreMi      lang={lang} />
    <Experiencia  lang={lang} />
    <Contacto     lang={lang} />
  </main>
</Layout>
