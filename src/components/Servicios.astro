---
// src/components/Servicios.astro

import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { services } from '../data/services';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="servicios" class="card-dark relative overflow-hidden px-8 md:px-12 lg:px-16 pt-10 pb-12 md:pt-12 md:pb-14">

  <!-- Orb decorativo sutil -->
  <div
    class="orb orb-neon"
    style="width:480px;height:480px;bottom:-160px;right:-100px;opacity:0.6;"
    aria-hidden="true"
  ></div>

  <div class="relative z-10">

    <!-- Header de sección -->
    <div class="flex items-end justify-between mb-8 md:mb-10">
      <div>
        <p class="type-label mb-2">{t(ui.services.eyebrow)}</p>
        <h2 class="type-section">{t(ui.services.title)}</h2>
      </div>
      <a href="#contacto" class="hidden md:inline-flex btn-primary">
        {t(ui.services.cta)} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="sep-dark mb-8 md:mb-10"></div>

    <!-- Grid de servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/[0.06] rounded-[14px] overflow-hidden">

      {services.map((s) => (
        <article class="group bg-[var(--color-surface)] p-7 md:p-8 flex flex-col gap-5
                         hover:bg-[var(--color-surface-2)] transition-colors duration-300">

          <!-- Número + título -->
          <div class="flex items-start justify-between gap-4">
            <h3 class="type-service">{t(s.title)}</h3>
            <span class="type-label text-neon shrink-0 mt-0.5">{s.num}</span>
          </div>

          <!-- Descripción -->
          <p class="type-body flex-1">{t(s.description)}</p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2">
            {s.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>

          <!-- Línea neon — aparece en hover -->
          <div class="h-px w-0 group-hover:w-full transition-all duration-500 ease-out"
               style="background: var(--color-neon); opacity: 0.35;"></div>

        </article>
      ))}

    </div>

    <!-- CTA mobile -->
    <div class="mt-8 md:hidden">
      <a href="#contacto" class="btn-primary w-full justify-center">
        {t(ui.services.cta)} <span aria-hidden="true">↗</span>
      </a>
    </div>

  </div>
</section>
