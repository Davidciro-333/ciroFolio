---
// src/components/Proyectos.astro
// Los sistemas como piezas de galería: un tile por sistema, una cifra real
// como protagonista (DESIGN.md §1 y §5). El bento tiene exactamente tantas
// celdas como sistemas; si cambia el número, cambia el patrón de SPANS.

import { ui } from '../i18n/ui';
import { useTranslations, localePath } from '../i18n/utils';
import { projects } from '../data/projects';
import { LOCALE_TAGS, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Ritmo del bento en 6 columnas: 4+2 / 3+3 / 2+2+2.
const SPANS = [4, 2, 3, 3, 2, 2, 2];
// El tile invertido: el polo opuesto de la página, uno solo.
const INVERTED = 'conversational-commerce';

const NUMBER_WORDS: Record<Lang, string[]> = {
  en: ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'],
  es: ['Cero', 'Uno', 'Dos', 'Tres', 'Cuatro', 'Cinco', 'Seis', 'Siete', 'Ocho', 'Nueve', 'Diez'],
};
const word = (n: number) => NUMBER_WORDS[lang][n] ?? String(n);
const liveCount = projects.filter((p) => p.liveSince).length;

const sinceLabel = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString(LOCALE_TAGS[lang], {
    year: 'numeric',
    month: 'short',
    timeZone: 'UTC',
  });

const items = projects.map((project, index) => ({
  ...project,
  span: SPANS[index] ?? 2,
  inverted: project.slug === INVERTED,
  href: project.hasCase ? localePath(lang, `/work/${project.slug}`) : undefined,
}));
---

<section id="systems" class="section wrap">
  <h2 class="sec-title reveal">
    {word(projects.length)} {t(ui.work.titleSystems)}<br />
    {word(liveCount)} {t(ui.work.titleRunning)}
  </h2>
  <p class="sec-sub reveal">{t(ui.work.sub)}</p>

  <ul class="bento">
    {items.map((p, index) => (
      <li
        class:list={['tile reveal', p.inverted && 'tile--inverted', p.href && 'is-link', index === 0 && 'is-lead']}
        style={`--span: ${p.span}`}
      >
        <p class="eyebrow">
          {p.liveSince && <span class="live-dot" aria-hidden="true"></span>}
          {p.liveSince && t(ui.status.live)}
          {p.liveSince && p.hasCase && <span aria-hidden="true">·</span>}
          {p.hasCase && t(ui.work.caseStudy)}
          {!p.liveSince && !p.hasCase && p.category && t(p.category)}
        </p>
        <h3>{p.name}</h3>
        <p class="desc">{t(p.short)}</p>

        <div class="figure">
          {p.figure.kind === 'days' && p.liveSince && (
            <>
              <p class="figure-num" data-days-since={p.liveSince}>{sinceLabel(p.liveSince)}</p>
              <p class="figure-label" data-days-label={t(ui.status.days)}>{t(ui.status.since)}</p>
            </>
          )}
          {p.figure.kind === 'value' && (
            <>
              <p class="figure-num">{p.figure.value}</p>
              <p class="figure-label">{t(p.figure.label)}</p>
            </>
          )}
          {p.figure.kind === 'statement' && (
            <>
              <p class="figure-num statement">{t(p.figure.text)}</p>
              <p class="figure-label">{t(p.figure.label)}</p>
            </>
          )}
          {p.href && (
            <a href={p.href} class="text-link more read">
              {t(ui.work.viewCase)}<span class="sr-only">: {p.name}</span>
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .sec-title,
  .sec-sub { text-align: center; }
  .sec-sub { max-width: 44ch; margin-left: auto; margin-right: auto; }

  .bento {
    list-style: none;
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  .tile {
    grid-column: span var(--span);
    min-height: 360px;
  }
  .tile:nth-child(n + 5) { min-height: 320px; }
  /* Único degradado permitido: la esquina del tile principal */
  .is-lead { background: linear-gradient(160deg, var(--parch) 55%, var(--tint)); }

  /* Todo el tile es clicable cuando tiene caso: el enlace se estira sobre él */
  /* Solo con ratón: en táctil el toque dispara el hover y el tile se queda arriba */
  @media (hover: hover) and (pointer: fine) {
    .is-link:hover { transform: translateY(-4px); }
  }
  .read::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .read:focus-visible { outline: none; }
  .is-link:has(.read:focus-visible) { outline: 2px solid var(--blue); outline-offset: 3px; }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-3);
  }
  h3 {
    margin-top: 8px;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .desc {
    margin-top: 12px;
    max-width: 44ch;
    font-size: 16px;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .figure {
    margin-top: auto;
    padding-top: 32px;
  }
  .statement {
    font-size: clamp(34px, 3.6vw, 52px);
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .figure-label {
    margin-top: 6px;
    font-size: 14px;
    color: var(--ink-3);
  }
  .read {
    display: inline-block;
    margin-top: 18px;
    font-size: 16px;
  }

  @media (max-width: 859px) {
    .bento { grid-template-columns: 1fr; margin-top: 40px; }
    .tile,
    .tile:nth-child(n + 5) { grid-column: auto; min-height: 0; }
  }
</style>

<script>
  // Días en producción: se calculan al cargar, nunca en el build (quedarían
  // congelados en la fecha del despliegue). Sin JavaScript se lee la fecha.
  // Al entrar en pantalla, el número cuenta hasta su valor real: es la única
  // cifra animada del sitio, porque es la única que de verdad se acumula.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const el of document.querySelectorAll<HTMLElement>('[data-days-since]')) {
    const start = Date.parse(`${el.dataset.daysSince}T00:00:00-05:00`);
    const days = Math.floor((Date.now() - start) / 86_400_000);
    if (Number.isNaN(days) || days < 1) continue;

    const label = el.nextElementSibling as HTMLElement | null;
    if (label?.dataset.daysLabel) label.textContent = label.dataset.daysLabel;

    if (reduce) {
      el.textContent = days.toLocaleString();
      continue;
    }
    // El lector de pantalla oye el valor final, no la cuenta intermedia
    const spoken = document.createElement('span');
    spoken.className = 'sr-only';
    spoken.textContent = days.toLocaleString();
    el.before(spoken);
    el.setAttribute('aria-hidden', 'true');

    el.textContent = '0';
    new IntersectionObserver(([entry], observer) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 1400);
        el.textContent = Math.round(days * (1 - Math.pow(1 - p, 4))).toLocaleString();
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, { threshold: 0.5 }).observe(el);
  }
</script>
