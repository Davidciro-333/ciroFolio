---
// src/components/Experiencia.astro
// Trayectoria como lista sobria centrada a 820 px. Galactic AIMA aparece una
// vez, como respaldo (ver src/data/timeline.ts).

import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { timeline, skills } from '../data/timeline';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const linkedin = profile.social.find((s) => s.label === 'LinkedIn')?.href;
// Rangos sin rayas (DESIGN.md §8): "Since 2025" o "2020-2024".
const period = (start: string, end: string | null) =>
  end ? `${start}-${end}` : `${t(ui.experience.since)} ${start}`;
---

<section id="experience" class="section wrap">
  <h2 class="sec-title reveal">{t(ui.experience.title)}</h2>

  <ol class="tl">
    {timeline.map((e) => (
      <li class="reveal">
        <span class="when">{period(e.start, e.end)}</span>
        <div>
          <h3>{t(e.role)}</h3>
          <p class="org">{t(e.org)}</p>
          <p class="desc">{t(e.description)}</p>
        </div>
      </li>
    ))}
  </ol>

  <div class="foot reveal">
    <dl class="skills">
      {skills.map((group) => (
        <div>
          <dt>{t(group.category)}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))}
    </dl>
    {linkedin && (
      <a href={linkedin} target="_blank" rel="noopener noreferrer" class="text-link">
        {t(ui.experience.linkedin)} <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</section>

<style>
  .sec-title { text-align: center; }
  .tl {
    list-style: none;
    margin: 56px auto 0;
    max-width: 820px;
  }
  li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .when {
    font-size: 15px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }
  h3 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .org { font-size: 15px; color: var(--ink-3); }
  .desc {
    margin-top: 8px;
    font-size: 15px;
    color: var(--ink-2);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .foot {
    max-width: 820px;
    margin: 0 auto;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
  }
  .skills {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    font-size: 14px;
  }
  dt { font-weight: 600; color: var(--ink-2); }
  dd { color: var(--ink-3); margin-top: 2px; }
  .foot .text-link { font-size: 15px; }

  @media (max-width: 859px) {
    .tl { margin-top: 40px; }
    li { grid-template-columns: 1fr; gap: 6px; }
    .skills { flex-direction: column; gap: 14px; }
  }
</style>
