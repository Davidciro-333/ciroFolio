---
// src/components/Experiencia.astro

import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { timeline, skills } from '../data/timeline';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const linkedin = profile.social.find((s) => s.label === 'LinkedIn')?.href;
---

<section id="experiencia" class="card-light relative overflow-hidden px-8 md:px-12 lg:px-16 pt-10 pb-12 md:pt-12 md:pb-14">

  <div class="relative z-10">

    <!-- Header -->
    <div class="flex items-end justify-between mb-8 md:mb-10">
      <div>
        <p class="type-label mb-2" style="color: var(--color-text-muted);">{t(ui.experience.eyebrow)}</p>
        <h2 class="type-section" style="color: #0a0a0c;">{t(ui.experience.title)}</h2>
      </div>
      <span class="type-label hidden md:block" style="color: rgba(0,0,0,0.15);">
        {t(profile.location).toUpperCase()} · {profile.timezone}
      </span>
    </div>

    <div class="sep-light mb-8 md:mb-10"></div>

    <!-- Layout: timeline izquierda / habilidades derecha -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-10 lg:gap-14">

      <!-- ── Timeline ─────────────────────────────────────── -->
      <div class="flex flex-col divide-y" style="border-color: rgba(0,0,0,0.07);">
        {timeline.map((e) => (
          <div class="flex flex-col md:flex-row gap-4 md:gap-8 py-7">

            <!-- Columna izquierda: periodo + tipo -->
            <div class="md:w-[160px] shrink-0 flex flex-row md:flex-col gap-3 md:gap-1.5">
              <p class="type-body-strong tabular-nums" style="color: #0a0a0c; font-size:13px;">
                {e.start} — {e.end ?? t(ui.experience.now)}
              </p>
              <p class="type-label" style="color: var(--color-text-muted);">{t(e.kind)}</p>
            </div>

            <!-- Columna derecha: rol + empresa + desc + tags -->
            <div class="flex-1 flex flex-col gap-3">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="type-service" style="color: #0a0a0c; font-size: clamp(15px,2vw,20px);">{t(e.role)}</h3>
                  <p class="type-label mt-1" style="color: var(--color-text-muted);">{t(e.org)}</p>
                </div>
                {e.active && (
                  <span
                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold shrink-0 mt-0.5"
                    style="background: rgba(200,241,53,0.12); color: #5a7000; border: 1px solid rgba(200,241,53,0.3);"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-[#c8f135] inline-block"></span>
                    {t(ui.experience.active)}
                  </span>
                )}
              </div>

              <p class="type-body" style="color: #555560;">{t(e.description)}</p>

              <div class="flex flex-wrap gap-2">
                {e.tags.map(tag => (
                  <span
                    class="inline-flex items-center px-3 py-1 rounded-[6px] text-[11px] font-medium"
                    style="background: rgba(0,0,0,0.05); color: #333340; border: 1px solid rgba(0,0,0,0.08);"
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- ── Habilidades ────────────────────────────────────── -->
      <div class="flex flex-col gap-6">

        <p class="type-label" style="color: var(--color-text-muted);">{t(ui.experience.skills)}</p>

        {skills.map(group => (
          <div>
            <p class="type-label mb-2" style="color: rgba(0,0,0,0.3);">{t(group.category)}</p>
            <ul class="flex flex-col gap-1.5">
              {group.items.map(item => (
                <li class="flex items-center gap-2">
                  <span style="width:4px;height:4px;border-radius:50%;background:var(--color-neon);flex-shrink:0;display:inline-block;"></span>
                  <span class="type-body" style="color: #333340;">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div style="height: 0.5px; background: rgba(0,0,0,0.07);"></div>

        <!-- El CV en inglés llega en una fase posterior; hasta entonces el
             enlace apunta al perfil de LinkedIn, que sí existe. -->
        <a
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-[12px] font-semibold
                 text-[#0a0a0c] hover:text-[var(--color-neon-dim)]
                 transition-colors duration-250"
        >
          {t(ui.experience.linkedin)} <span aria-hidden="true">↗</span>
        </a>

      </div>

    </div>

  </div>
</section>
