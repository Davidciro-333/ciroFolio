---
// src/layouts/Layout.astro
// Layout base — envuelve todas las páginas

import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { withBase } from '../lib/url';
import { getAlternates } from '../i18n/utils';
import { LOCALES, LOCALE_TAGS, OG_LOCALES, DEFAULT_LOCALE, type Lang } from '../i18n/config';
import { SITE_NAME, meta, ogImageAlt } from '../data/seo';
import { OG_WIDTH, OG_HEIGHT } from '../lib/og-routes';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Ruta a la imagen de Open Graph. Sin valor no se emiten las metas de imagen. */
  ogImage?: string;
  /**
   * Texto grande impreso en la tarjeta. Solo se usa para construir
   * `og:image:alt`; por defecto se asume que es el título de la página.
   */
  ogImageHeading?: string;
  /** `article` en los casos de estudio, `website` en el resto. */
  ogType?: 'website' | 'article';
}

const { lang, ogImage, ogImageHeading, ogType = 'website' } = Astro.props;
const title = Astro.props.title ?? meta.title[lang];
const description = Astro.props.description ?? meta.description[lang];

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(withBase(ogImage), Astro.site).href : undefined;
const imageAlt = ogImageAlt[lang](ogImageHeading ?? title);

// Declara que la misma página existe en el otro idioma.
const alternateLocales = LOCALES.filter((locale) => locale !== lang);

// La misma página en cada idioma, para las etiquetas hreflang.
const alternates = getAlternates(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang={LOCALE_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="David Ciro" />
    <link rel="canonical" href={canonical.href} />

    <!-- Versiones por idioma -->
    {LOCALES.map((locale) => (
      <link
        rel="alternate"
        hreflang={LOCALE_TAGS[locale]}
        href={new URL(alternates[locale], Astro.site).href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates[DEFAULT_LOCALE], Astro.site).href}
    />

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonical.href} />
    <meta property="og:type"        content={ogType} />
    <meta property="og:site_name"   content={SITE_NAME} />
    <meta property="og:locale"      content={OG_LOCALES[lang]} />
    {alternateLocales.map((locale) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[locale]} />
    ))}
    {ogImageUrl && (
      <>
        <meta property="og:image"        content={ogImageUrl} />
        <meta property="og:image:type"   content="image/png" />
        {/* LinkedIn y WhatsApp reservan el hueco con estas dos: sin ellas a
            veces no pintan la imagen en el primer scrapeo. */}
        <meta property="og:image:width"  content={String(OG_WIDTH)} />
        <meta property="og:image:height" content={String(OG_HEIGHT)} />
        <meta property="og:image:alt"    content={imageAlt} />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card"        content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && (
      <>
        <meta name="twitter:image"     content={ogImageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- Plus Jakarta Sans se sirve desde el propio sitio (@fontsource), sin
         pedir nada a Google: una petición de terceros menos en cada visita. -->

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />

    <!-- Tema, ANTES de pintar: si el visitante eligió uno, se aplica ya; si no,
         manda el del sistema (CSS). Hacerlo después daría un fogonazo blanco
         a quien navega en oscuro. La clase .js habilita las entradas animadas:
         sin JavaScript nada queda oculto. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>

    <title>{title}</title>

  </head>

  <body>
    <slot />

    <script>
      // Entradas al ver: cada .reveal aparece al entrar en pantalla, escalonado
      // respecto a sus hermanos (70 ms, máximo 5 pasos). Una sola vez.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            const siblings = [...(el.parentElement?.children ?? [])].filter((c) =>
              c.classList.contains('reveal'),
            );
            const index = siblings.indexOf(el);
            if (index > 0) el.style.transitionDelay = `${Math.min(index, 5) * 70}ms`;
            el.classList.add('is-in');
            observer.unobserve(el);
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal, .hl').forEach((el) => observer.observe(el));
    </script>

    <script>
      // Vercel Analytics. El sitio vive detrás del rewrite de BioLink
      // (itsciro.com/cirofolio/* → ciro-folio.vercel.app/*), así que el script y
      // el endpoint llevan la base delante: sin ella irían a
      // itsciro.com/_vercel/insights y las visitas se contarían en el proyecto
      // de BioLink, no en este. Solo en producción: en local no hay endpoint.
      //
      // Se usa inject() y no el componente <Analytics /> del paquete: ese
      // componente reescribe import.meta.env y en `astro dev` rompe Vite
      // ("Cannot split a chunk that has already been edited").
      import { inject } from '@vercel/analytics';

      if (import.meta.env.PROD) {
        const base = import.meta.env.BASE_URL.replace(/\/$/, '');
        inject({
          framework: 'astro',
          scriptSrc: `${base}/_vercel/insights/script.js`,
          endpoint: `${base}/_vercel/insights`,
        });
      }
    </script>
  </body>
</html>
