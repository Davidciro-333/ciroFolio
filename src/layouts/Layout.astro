---
// src/layouts/Layout.astro
// Layout base — envuelve todas las páginas

import '../styles/global.css';
import { withBase } from '../lib/url';
import { getAlternates } from '../i18n/utils';
import { LOCALES, LOCALE_TAGS, OG_LOCALES, DEFAULT_LOCALE, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Ruta a la imagen de Open Graph. Sin valor no se emiten las metas de imagen. */
  ogImage?: string;
}

const defaults = {
  en: {
    title: 'David Ciro — Developer & Designer',
    description:
      'David Ciro’s portfolio. Developer and UI designer based in Medellín, Colombia. AI automation, conversational systems and product engineering.',
  },
  es: {
    title: 'David Ciro — Desarrollador & Diseñador Web',
    description:
      'Portafolio de David Ciro. Desarrollador y diseñador UI basado en Medellín, Colombia. Automatización con IA, sistemas conversacionales e ingeniería de producto.',
  },
} as const;

const { lang, ogImage } = Astro.props;
const title = Astro.props.title ?? defaults[lang].title;
const description = Astro.props.description ?? defaults[lang].description;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(withBase(ogImage), Astro.site).href : undefined;

// La misma página en cada idioma, para las etiquetas hreflang.
const alternates = getAlternates(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang={LOCALE_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="David Ciro" />
    <link rel="canonical" href={canonical.href} />

    <!-- Versiones por idioma -->
    {LOCALES.map((locale) => (
      <link
        rel="alternate"
        hreflang={LOCALE_TAGS[locale]}
        href={new URL(alternates[locale], Astro.site).href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates[DEFAULT_LOCALE], Astro.site).href}
    />

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonical.href} />
    <meta property="og:type"        content="website" />
    <meta property="og:locale"      content={OG_LOCALES[lang]} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <!-- Twitter -->
    <meta name="twitter:card"        content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- Fuentes: Inter desde Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Nohemi se sirve desde src/assets/fonts vía @font-face en global.css -->

    <title>{title}</title>
  </head>

  <body>
    <!-- Ruido de fondo sutil (opcional, mejora la textura) -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 z-0 opacity-[0.025]"
      style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/></filter><rect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22 opacity=%221%22/></svg>'); background-size: 200px;"
    ></div>

    <!-- Contenido de la página -->
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
